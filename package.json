{
  "name": "devtools-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "check:public": "node scripts/check-public-repo.mjs",
    "dev": "node scripts/astro.mjs dev",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "typecheck": "node scripts/astro.mjs check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "astro": "7.4.4",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
