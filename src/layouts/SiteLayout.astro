---
import '../styles/global.css';
import ThemeControl from '../components/astro/ThemeControl.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const isHome = Astro.url.pathname === '/devtools-hub/';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="no-referrer" />
    {!noindex && (
      <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    )}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/devtools-hub/favicon.svg" type="image/svg+xml" />
    <title>{title} — DevTools Hub</title>
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const stored = localStorage.getItem('devtools-theme');
          if (stored === 'light' || stored === 'dark') preference = stored;
        } catch {
          /* Storage may be blocked; system preference still works. */
        }
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme =
          preference === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <header class="site-header">
      <div class="shell header-inner">
        <a
          href="/devtools-hub/"
          class="brand"
          aria-label="DevTools Hub — início"
        >
          <span class="brand-mark" aria-hidden="true">
            &lt;/&gt;
          </span>
          <span>
            DevTools <span class="brand-light">Hub</span>
          </span>
        </a>
        <nav aria-label="Navegação principal">
          <a
            href="/devtools-hub/#ferramentas"
            aria-current={isHome ? 'page' : undefined}
          >
            Ferramentas
          </a>
          <a
            href="/devtools-hub/privacidade/"
            aria-current={
              Astro.url.pathname.startsWith('/devtools-hub/privacidade')
                ? 'page'
                : undefined
            }
          >
            Privacidade
          </a>
        </nav>
        <ThemeControl />
      </div>
    </header>
    <main id="conteudo" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>
          DevTools Hub <span class="footer-divider">/</span> Utilitários para o
          dia a dia.
        </p>
        <a href="/devtools-hub/privacidade/">
          Como tratamos seus dados <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
  </body>
</html>
